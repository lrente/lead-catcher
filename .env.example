# Copy this file to .env and replace every placeholder before starting the stack.
N8N_DOMAIN=localhost

POSTGRES_DB=lead_automation
POSTGRES_USER=lead_automation
POSTGRES_PASSWORD=replace-with-a-long-random-password

N8N_ENCRYPTION_KEY=replace-with-at-least-32-random-characters
META_APP_SECRET=replace-with-your-meta-app-secret
META_VERIFY_TOKEN=replace-with-a-long-random-verification-token

# Outbound WhatsApp and local approval API
META_ACCESS_TOKEN=replace-with-your-meta-system-user-access-token
META_GRAPH_API_VERSION=replace-with-supported-version-such-as-vNN.N
WHATSAPP_TIMEOUT_SECONDS=25
APPROVAL_API_TOKEN=replace-with-at-least-32-random-characters

# Qualification worker and Anthropic Messages API
ANTHROPIC_API_KEY=replace-with-your-anthropic-api-key
ANTHROPIC_MODEL=replace-with-your-selected-model
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_TIMEOUT_SECONDS=25
ANTHROPIC_MAX_TOKENS=700
QUALIFICATION_DEBOUNCE_SECONDS=8
QUALIFICATION_LEASE_SECONDS=120
QUALIFICATION_MINIMUM_CONFIDENCE=0.6
QUALIFICATION_MAX_ATTEMPTS=3
